[user]
	signingkey = A80574CB
	email = r.sickenberg@gmail.com
	name = Sickenberg Romain
[commit]
	gpgSign = true
[pull]
	rebase = true
[credential]
	helper = cache
[core]
	excludesfile = /Users/romainsickenberg/.gitignore_global
	fileMode = false
	pager = less -+FX
	#sshCommand = ssh -i ~/.ssh/id_ed25519 -F /dev/null
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[tag]
	forceSignAnnotated = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[maintenance]
	repo = /Users/romainsickenberg/Projects/haux49/rsickenberg.me
	repo = /Users/romainsickenberg/Projects/citydeals/api
	repo = /Users/romainsickenberg/Projects/muum/app_ios
	repo = /Users/romainsickenberg/.dotfiles
	repo = /Users/romainsickenberg/Projects/haux49/api.teslacompanion
	repo = /Users/romainsickenberg/Projects/haux49/archive/easypackages
	repo = /Users/romainsickenberg/Projects/haux49/ATPL_Formula_Kit
	repo = /Users/romainsickenberg/Projects/haux49/flywithme
	repo = /Users/romainsickenberg/Projects/haux49/flywithme_sf
	repo = /Users/romainsickenberg/Projects/haux49/fortnite_wiki_server
	repo = /Users/romainsickenberg/Projects/haux49/StatusBuddy
	repo = /Users/romainsickenberg/Projects/haux49/StrvBike
	repo = /Users/romainsickenberg/Projects/haux49/TESLA_WATCH/Tesla@Wrist
	repo = /Users/romainsickenberg/Projects/haux49/TeslaCompagnonWebsite
	repo = /Users/romainsickenberg/Projects/haux49/TeslaSwift
	repo = /Users/romainsickenberg/Projects/haux49/wattson
	repo = /Users/romainsickenberg/Projects/eternalTwin/mush
	repo = /Users/romainsickenberg/Projects/SIL/atlas
	repo = /Users/romainsickenberg/Projects/SIL/courses-gaz
	repo = /Users/romainsickenberg/Projects/SIL/db_postgres
